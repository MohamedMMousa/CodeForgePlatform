# Copy to .env and fill in real values for local docker-compose use.
# .env is gitignored — never commit real secrets here.

POSTGRES_USER=codeforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codeforge_db

# Long random string — e.g. `openssl rand -base64 48`. Never reuse the dev/CI value.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: bootstraps the first super-admin on first boot. Leave both blank to skip
# seeding (DatabaseSeeder no-ops without them).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

CORS_ALLOWED_ORIGIN=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Production
